# --- Database ---------------------------------------------------------
# Local dev: point at your local Postgres.
# Production (Docker Compose): points at PgBouncer, not Postgres directly.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/critwire
DATABASE_POOL_MAX=20

# E2E only (`pnpm test:e2e`). WARNING: this database is DROPPED and
# re-migrated on every run. Use a dedicated database whose name ends in
# _e2e (e.g. `createdb critwire_e2e`), never your dev database.
# E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/critwire_e2e
# E2E_PORT=3100   # webhook test sink listens on E2E_PORT+1

# Used by docker-compose.yml to provision Postgres/PgBouncer.
DB_USER=critwire
DB_PASSWORD=CHANGE_ME
DB_NAME=critwire

# --- Payload ----------------------------------------------------------
# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Structured JSON logging level: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# Secret used to authenticate scheduled job execution requests.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate live-preview requests.
PREVIEW_SECRET=YOUR_SECRET_HERE

# --- Cloudflare R2 (media storage) -------------------------------------
# Leave unset in local dev to store uploads on local disk instead.
# R2_BUCKET=critwire-media
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Upstash Redis (rate limiting, domain cache) ------------------------
# Required in production: public forms and voting refuse requests
# without it. Optional in local dev, where rate limiting is off.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# E2E only; never set in production. Lets the production build run
# without Upstash (the E2E harness sets it).
# RATE_LIMIT_OPTIONAL=1

# --- AI site generation --------------------------------------------------
# Server-only. The model defaults to the pinned production snapshot below.
# OPENAI_API_KEY=
# OPENAI_SITE_MODEL=gpt-5.4-mini-2026-03-17

# --- Public form protection ---------------------------------------------
# Required in production: public forms refuse submissions without
# TURNSTILE_SECRET_KEY, and the widget needs the site key. Optional in
# local dev, where forms run without Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# --- Email ---------------------------------------------------------------
# Required in production when a studio routes contact to email: without
# it, those contact jobs fail (a super admin can retry them once set).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Critwire <notifications@example.com>

# --- Backups --------------------------------------------------------------
# Used by the Phase 7 deploy runbook when configuring daily pg_dump uploads.
# BACKUP_R2_BUCKET=critwire-db-backups
# BACKUP_R2_PREFIX=production

# --- Contact delivery ------------------------------------------------------
# E2E only; never set in production. The one non-Discord origin a contact
# webhook may target (the E2E harness sets it to its local sink).
# DISCORD_WEBHOOK_TEST_ORIGIN=

# --- Sentry -------------------------------------------------------------
# Leave unset to disable. NEXT_PUBLIC_ vars reach the browser bundle.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=   # only needed for source-map upload during build
